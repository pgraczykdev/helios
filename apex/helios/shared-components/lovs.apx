lov boolean (
    name: BOOLEAN
    source {
        location: staticValues
    }

    entry false (
        sequence: 2
        display: No
        return: FALSE
    )

    entry true (
        sequence: 1
        display: Yes
        return: TRUE
    )

)

lov logger-levels (
    name: LOGGER_LEVELS
    source {
        location: localDatabase
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT
                d,
                r,
                lvl_order
            FROM pkg_apex_queries.f_lov_logger_levels()
            ```
    }
    columnMapping {
        return: R
        display: D
        defaultSort: LVL_ORDER
        sortDirection: ascNullsLast
    }
)

